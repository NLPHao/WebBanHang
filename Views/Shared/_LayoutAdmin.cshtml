<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Trang Quản Trị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* CSS Riêng cho giao diện Admin */
        body {
            background-color: #f8f9fa;
            overflow-x: hidden;
        }

        #wrapper {
            display: flex;
            width: 100%;
            height: 100vh;
        }

        /* Sidebar (Menu trái) */
        #sidebar-wrapper {
            min-height: 100vh;
            width: 250px;
            background-color: #343a40; /* Màu nền tối */
            color: #fff;
            transition: all 0.3s;
        }

        .sidebar-heading {
            padding: 1.5rem;
            font-size: 1.2rem;
            font-weight: bold;
            border-bottom: 1px solid #4b545c;
        }

        .list-group-item {
            background-color: transparent;
            color: #c2c7d0;
            border: none;
            padding: 15px 20px;
        }

            .list-group-item:hover {
                background-color: #494e53;
                color: #fff;
                cursor: pointer;
            }

            .list-group-item.active {
                background-color: #007bff;
                color: white;
                font-weight: bold;
            }

            .list-group-item i {
                width: 25px;
            }

        /* Content (Nội dung phải) */
        #page-content-wrapper {
            width: 100%;
            overflow-y: auto;
        }

        .navbar-admin {
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
            background: white;
        }
    </style>
</head>
<body>

    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading text-center">
                <i class="fa-solid fa-shield-halved me-2"></i>ADMIN BCTTECHSTORE
            </div>
            <div class="list-group list-group-flush mt-3">
                <a href="@Url.Action("Index", "Admin")" class="list-group-item list-group-item-action active">
                    <i class="fa-solid fa-gauge"></i> Tổng quan (Dashboard)
                </a>
                <a href="@Url.Action("Index", "QuanLySanPham")" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-box-open"></i> Quản lý sản phẩm
                </a>
                <a href="@Url.Action("Index", "QuanLyDonHang")" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-cart-shopping"></i> Quản lý đơn hàng
                </a>
                <a href="@Url.Action("Index", "QuanLyTaiKhoan")" class="list-group-item list-group-item-action">
                    <i class="fa-solid fa-users"></i> Quản lý tài khoản
                </a>
                <a href="@Url.Action("DangXuat", "DangNhap")" class="list-group-item list-group-item-action text-danger mt-5">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>
            </div>
        </div>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light navbar-admin px-4 py-3 justify-content-between">
                <h4 class="m-0 text-primary">@ViewBag.Title</h4>
                <div class="d-flex align-items-center">
                    <span class="me-2 text-secondary">Xin chào, <b>@Session["TenHienThi"]</b></span>
                    <img src="https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff" class="rounded-circle" width="40">
                </div>
            </nav>

            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>