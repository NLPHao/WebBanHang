@using WebBanHang.Models
@model List<chi_tiet_don_hang>

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    don_hang donHang = ViewBag.DonHang;
}

<div class="container py-5">
    <div class="mb-3">
        <a href="@Url.Action("Index", "QuanLyDonHang")" class="text-decoration-none text-muted">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="fa-solid fa-user me-2"></i> THÔNG TIN KHÁCH HÀNG
                </div>
                <div class="card-body">
                    <p><strong>Người đặt:</strong> @donHang.nguoi_dung.ho_ten</p>
                    <p><strong>Ngày đặt:</strong> @string.Format("{0:dd/MM/yyyy HH:mm}", donHang.ngay_dat_hang)</p>
                    <hr />
                    <p><strong>Người nhận:</strong> @donHang.nguoi_dung.ho_ten (Mặc định)</p>
                    <p><strong>SĐT Nhận:</strong> <span class="text-primary fw-bold">@donHang.so_dien_thoai_nhan</span></p>
                    <p><strong>Địa chỉ:</strong> @donHang.dia_chi_giao_hang</p>
                    <p><strong>Ghi chú:</strong> <em class="text-muted">@(donHang.ghi_chu ?? "Không có")</em></p>

                    <div class="mt-3">
                        <label>Trạng thái hiện tại:</label>
                        @if (donHang.trang_thai_don_hang == "Chờ xử lý")
                        {
                            <div class="alert alert-warning py-2 mt-1 fw-bold text-center">⏳ ĐANG CHỜ XỬ LÝ</div>
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("DuyetDon", "QuanLyDonHang", new { id = donHang.id_don_hang })" class="btn btn-success">✅ Xác nhận đã giao</a>
                                <a href="@Url.Action("HuyDon", "QuanLyDonHang", new { id = donHang.id_don_hang })" class="btn btn-outline-danger">❌ Hủy bỏ đơn hàng</a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success py-2 mt-1 fw-bold text-center">@donHang.trang_thai_don_hang</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fa-solid fa-box-open me-2"></i> DANH SÁCH SẢN PHẨM (Mã: #@donHang.id_don_hang)
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="~/images/@item.san_pham.hinh_anh_dai_dien" width="50" height="50" style="object-fit:cover; border-radius:5px; border:1px solid #ddd;" />
                                            <span class="ms-3 fw-bold">@item.san_pham.ten_san_pham</span>
                                        </div>
                                    </td>
                                    <td class="text-center">x @item.so_luong</td>
                                    <td class="text-end">@string.Format("{0:#,##0}", item.don_gia)</td>
                                    <td class="text-end fw-bold pe-4">
                                        @string.Format("{0:#,##0}đ", item.so_luong * item.don_gia)
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5 py-3">TỔNG CỘNG PHẢI THU:</td>
                                <td class="text-end text-danger fw-bold fs-4 pe-4">
                                    @string.Format("{0:#,##0}đ", donHang.tong_tien)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>