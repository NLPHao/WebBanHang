@model WebBanHang.Models.san_pham

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Thêm sản phẩm mới</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "QuanLySanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên sản phẩm</label>
                        @Html.EditorFor(model => model.ten_san_pham, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                            @Html.EditorFor(model => model.gia_ban, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Giá khuyến mãi</label>
                            @Html.EditorFor(model => model.gia_khuyen_mai, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea class="form-control" name="mo_ta_chi_tiet" rows="5"></textarea>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục</label>
                        @Html.DropDownList("id_danh_muc", null, htmlAttributes: new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Thương hiệu</label>
                        @Html.DropDownList("id_thuong_hieu", null, htmlAttributes: new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số lượng tồn kho</label>
                        @Html.EditorFor(model => model.so_luong_ton, new { htmlAttributes = new { @class = "form-control", type = "number", Value = "0" } })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh đại diện</label>
                        <input type="file" name="hinh_anh" class="form-control" accept="image/*" required />
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a href="@Url.Action("Index")" class="btn btn-secondary me-2">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-save"></i> Lưu Sản Phẩm</button>
            </div>
        }
    </div>
</div>