@model IEnumerable<WebBanHang.Models.san_pham>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách sản phẩm</h6>
        <a href="@Url.Action("Create")" class="btn btn-success btn-sm">
            <i class="fa-solid fa-plus"></i> Thêm mới
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Danh mục</th>
                        <th>Kho</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="~/Images/@item.hinh_anh_dai_dien" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" />
                            </td>
                            <td style="max-width: 300px;">@item.ten_san_pham</td>
                            <td class="text-danger fw-bold">@string.Format("{0:N0} đ", item.gia_ban)</td>
                            <td>@item.danh_muc.ten_danh_muc</td>
                            <td>@item.so_luong_ton</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.id_san_pham })" class="btn btn-primary btn-sm" title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.id_san_pham })" class="btn btn-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>