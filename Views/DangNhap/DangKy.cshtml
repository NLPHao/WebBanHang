@model WebBanHang.Models.DangKyViewModel

@{
    ViewBag.Title = "Đăng Ký Thành Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="background-color: #f8f9fa;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-gradient bg-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold"><i class="fa-solid fa-user-shield me-2"></i>ĐĂNG KÝ TÀI KHOẢN</h3>
                    <p class="mb-0 text-white-50 small">Trở thành thành viên để nhận nhiều ưu đãi</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @using (Html.BeginForm("DangKy", "DangNhap", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <strong><i class="fa-solid fa-triangle-exclamation"></i> Có lỗi xảy ra:</strong>
                                    @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Họ và tên <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-user-tag"></i></span>
                                    @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Nguyễn Văn A" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger small ms-1" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Tên đăng nhập <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-user"></i></span>
                                    @Html.EditorFor(model => model.TaiKhoan, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập username..." } })
                                </div>
                                @Html.ValidationMessageFor(model => model.TaiKhoan, "", new { @class = "text-danger small ms-1" })
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fa-solid fa-lock"></i></span>
                                        @Html.EditorFor(model => model.MatKhau, new { htmlAttributes = new { @class = "form-control", Type = "password", placeholder = "******" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger small ms-1" })
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Nhập lại MK <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fa-solid fa-check-double"></i></span>
                                        @Html.EditorFor(model => model.XacNhanMatKhau, new { htmlAttributes = new { @class = "form-control", Type = "password", placeholder = "******" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.XacNhanMatKhau, "", new { @class = "text-danger small ms-1" })
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Email <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope"></i></span>
                                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "email@example.com" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small ms-1" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-phone"></i></span>
                                    @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control", placeholder = "09xxxxxxxxx" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger small ms-1" })
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                                    ĐĂNG KÝ NGAY
                                </button>
                            </div>

                            <div class="text-center mt-4">
                                <span class="text-muted">Bạn đã có tài khoản?</span>
                                <a href="@Url.Action("DangNhap", "DangNhap")" class="fw-bold text-primary text-decoration-none">Đăng nhập tại đây</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>