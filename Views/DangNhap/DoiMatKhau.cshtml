@{
    ViewBag.Title = "Đổi Mật Khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Đổi Mật Khẩu</h2>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-success">@ViewBag.ThongBao</div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-2">Mật khẩu cũ</label>
            <div class="col-md-10">
                <input type="password" name="matKhauCu" class="form-control" required />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Mật khẩu mới</label>
            <div class="col-md-10">
                <input type="password" name="matKhauMoi" class="form-control" required />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Nhập lại MK mới</label>
            <div class="col-md-10">
                <input type="password" name="xacNhanMatKhau" class="form-control" required />
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
            </div>
        </div>
    </div>
}