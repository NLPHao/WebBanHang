@model WebBanHang.Models.nguoi_dung

@{
    ViewBag.Title = "Phân quyền tài khoản";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow border-0 col-md-6">
        <div class="card-header bg-warning text-dark fw-bold text-center">
            <i class="fa-solid fa-user-gear me-2"></i> CẤP QUYỀN TRUY CẬP
        </div>
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <img src="~/images/@(Model.anh_dai_dien ?? "default_user.jpg")"
                     width="100" height="100" class="rounded-circle border mb-2" />
                <h4 class="fw-bold">@Model.ho_ten</h4>
                <p class="text-muted">@Model.email</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.id_nguoi_dung)

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn vai trò mới:</label>
                    @Html.DropDownList("id_vai_tro", (IEnumerable<SelectListItem>)ViewBag.DanhSachQuyen, new { @class = "form-select form-select-lg" })
                    <div class="form-text text-muted mt-2">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        <b>Quản trị viên:</b> Toàn quyền hệ thống.<br />
                        <b>Nhân viên:</b> Quản lý đơn hàng, sản phẩm.<br />
                        <b>Khách hàng:</b> Chỉ được mua hàng.
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-warning fw-bold py-2">
                        <i class="fa-solid fa-floppy-disk me-2"></i> LƯU THAY ĐỔI
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-light border">Hủy bỏ</a>
                </div>
            }
        </div>
    </div>
</div>