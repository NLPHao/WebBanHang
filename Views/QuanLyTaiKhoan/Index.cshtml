@model IEnumerable<WebBanHang.Models.nguoi_dung>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <h3 class="text-primary fw-bold mb-4">DANH SÁCH TÀI KHOẢN HỆ THỐNG</h3>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="py-3 ps-3">Avatar</th>
                        <th>Thông tin tài khoản</th>
                        <th>Email / SĐT</th>
                        <th>Quyền hạn (Vai trò)</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <img src="~/images/@(item.anh_dai_dien ?? "default_user.jpg")"
                                     width="50" height="50" class="rounded-circle border" style="object-fit:cover;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.ho_ten</div>
                                <small class="text-muted">TK: @item.tai_khoan</small>
                            </td>
                            <td>
                                <div><i class="fa-regular fa-envelope me-1"></i> @item.email</div>
                                <div><i class="fa-solid fa-phone me-1"></i> @item.so_dien_thoai</div>
                            </td>
                            <td>
                                @if (item.id_vai_tro == 1) // Admin
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-shield-halved me-1"></i> @item.vai_tro.ten_vai_tro
                                    </span>
                                }
                                else if (item.id_vai_tro == 2) // Nhân viên
                                {
                                    <span class="badge bg-primary rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-user-tie me-1"></i> @item.vai_tro.ten_vai_tro
                                    </span>
                                }
                                else // Khách hàng
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-user me-1"></i> @item.vai_tro.ten_vai_tro
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("PhanQuyen", "QuanLyTaiKhoan", new { id = item.id_nguoi_dung })"
                                   class="btn btn-sm btn-warning fw-bold text-dark">
                                    <i class="fa-solid fa-user-gear me-1"></i> Cấp quyền
                                </a>

                                @if (Session["TaiKhoan"] != null && ((WebBanHang.Models.nguoi_dung)Session["TaiKhoan"]).id_nguoi_dung != item.id_nguoi_dung)
                                {
                                    <a href="@Url.Action("XoaTaiKhoan", "QuanLyTaiKhoan", new { id = item.id_nguoi_dung })"
                                       class="btn btn-sm btn-outline-danger ms-1"
                                       onclick="return confirm('Bạn có chắc muốn xóa tài khoản này không? Dữ liệu đơn hàng liên quan có thể bị lỗi.')">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>